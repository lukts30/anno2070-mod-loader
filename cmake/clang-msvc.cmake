set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(CMAKE_C_COMPILER clang-cl)
set(CMAKE_CXX_COMPILER clang-cl)
set(CMAKE_C_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_LINKER lld-link)
set(CMAKE_AR llvm-lib)
set(CMAKE_RC_COMPILER llvm-rc)
# xwin has no Windows mt.exe. LLD embeds the generated manifest itself.
set(CMAKE_MT llvm-mt)
# xwin's default splat contains the redistributable release libraries only.
set(CMAKE_TRY_COMPILE_CONFIGURATION Release)

if(NOT DEFINED ENV{XWIN_ROOT})
  message(FATAL_ERROR "Set XWIN_ROOT to the absolute path of an xwin splat")
endif()
file(TO_CMAKE_PATH "$ENV{XWIN_ROOT}" xwin)
if(NOT EXISTS "${xwin}/crt/include/vcruntime.h")
  message(FATAL_ERROR "XWIN_ROOT does not contain the Microsoft CRT headers")
endif()
set(includes "")
foreach(dir crt/include sdk/include/ucrt sdk/include/shared sdk/include/um sdk/include/winrt)
  string(APPEND includes " /imsvc\"${xwin}/${dir}\"")
endforeach()
set(CMAKE_C_FLAGS_INIT "${includes}")
set(CMAKE_CXX_FLAGS_INIT "${includes}")
set(libraries "")
foreach(dir crt/lib/x86_64 sdk/lib/ucrt/x86_64 sdk/lib/um/x86_64)
  string(APPEND libraries " /libpath:\"${xwin}/${dir}\"")
endforeach()
set(CMAKE_EXE_LINKER_FLAGS_INIT "${libraries}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${libraries}")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${libraries}")
